generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Day {
  id        String   @id @default(cuid())
  date      String   @unique
  tasks     String   @default("{}") // JSON as String
  habit     String? // "clean" | "slip"
  triggers  String   @default("[]") // JSON array as String
  habitNote String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
